# Copy to .dev.vars for local `npm run dev` (gitignored)
LLM_RELAY_BASE_URL=https://your-relay.example.com/v1
LLM_RELAY_API_KEY=sk-xxxx
LLM_MODEL=grok-composer-2.5-fast

# Lemon Squeezy (sole payment provider; checkout requires all LS_* set)
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.xxxx
LEMONSQUEEZY_WEBHOOK_SECRET=random-32-char-secret
LS_STORE_ID=442392
LS_VARIANT_RESUME_ID=000000
LS_VARIANT_BUNDLE_ID=000000

# HMAC signing key for in-app license tokens (long random string)
LICENSE_SIGNING_SECRET=change-me-random-secret

# "true" only when the payment channel is live; otherwise buy button collects leads
CHECKOUT_ENABLED=false
