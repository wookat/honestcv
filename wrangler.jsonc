{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honestcv",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.ts",
  "routes": [{ "pattern": "cv.zalize.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    // Stores licenses / free quotas / leads. Placeholder id — create with
    // `wrangler kv namespace create KV` before deploying and replace below.
    { "binding": "KV", "id": "REPLACE_KV_ID" }
  ],
  "vars": {
    // LLM_RELAY_BASE_URL / LLM_RELAY_API_KEY / LLM_MODEL, plus payment secrets
    // PADDLE_API_KEY / PADDLE_WEBHOOK_SECRET / PADDLE_PRICE_RESUME_ID /
    // PADDLE_PRICE_BUNDLE_ID / LICENSE_SIGNING_SECRET are set via
    // `wrangler secret put` or .dev.vars. Never hardcode secrets here.
    "LLM_MODEL": "gpt-4o-mini",
    // Checkout switch: flip to "true" once the Paddle account/product is approved.
    // While "false" the buy button degrades to an email waitlist (POST /api/leads).
    "CHECKOUT_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}
